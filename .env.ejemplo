# Copia este archivo como .env y llena tus valores REALES.
# El archivo .env esta en .gitignore: nunca debe llegar al repositorio.
DB_HOST=tu-instancia.xxxxx.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=clipshare
DB_USER=clipshare_admin
DB_PASSWORD=
AWS_REGION=us-east-1
S3_BUCKET=
# Firma de las sesiones. Genera una con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Opcional (valores por defecto)
MAX_UPLOAD_MB=50
MAX_DURACION_S=300
# En EC2 NO pongas llaves de AWS: la instancia usa su rol (LabInstanceProfile).
# En tu laptop, exporta AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN
# en tu terminal (no en este archivo) si quieres probar contra el S3 real.
